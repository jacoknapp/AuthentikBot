# Example environment file for Authentik Discord Invite Bot
# Copy this to .env and fill in with your actual values

# Discord Bot Configuration
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Authentik Configuration
# Base URL of your Authentik instance (include https://)
AUTHENTIK_URL=https://authentik.example.com

# Authentik API Token
# Generate this in Authentik admin panel → Administration → System → Tokens & App Passwords
AUTHENTIK_TOKEN=your_authentik_api_token_here

# Authentik Flow Slug
# Usually something like "default-enrollment-flow" or "enrollment"
AUTHENTIK_FLOW_SLUG=default-enrollment-flow

# Optional: Default expiration time for invites in hours
# Minimum: 1, Maximum: 8760 (1 year), Default: 24
INVITE_EXPIRATION_HOURS=24

# Required: Restrict commands to one exact Discord channel
# Get channel ID by right-clicking a channel in Discord → Copy Channel ID
# Missing value stops startup (and recovery always denies)
COMMAND_CHANNEL_ID=

# Optional: Restrict commands to members with a specific Discord role ID
# Right-click a role in Discord → Copy Role ID
# Leave empty to allow all server members to use commands
REQUIRED_ROLE_ID=

# Optional: Immutable usernames (comma-separated)
# Users listed here cannot be added or removed from groups via the bot
# Example: admin,system,root
IMMUTABLE_USERNAMES=

# Recovery stays disabled until separately reviewed and approved. See RECOVERY.md.
# No credentials, caller IDs, guild IDs, or target usernames are supplied here.
RECOVERY_EMAIL_ENABLED=false
RECOVERY_MFA_ENABLED=false
RECOVERY_AUTHENTIK_TOKEN=
RECOVERY_SERVICE_USERNAME=
RECOVERY_GUILD_ID=
RECOVERY_DISCORD_USER_IDS=
RECOVERY_TARGET_USERNAMES=
RECOVERY_FLOW_SLUG=
RECOVERY_EMAIL_STAGE_UUID=5780da44-a43d-4791-b14e-e880cc8aa895
RECOVERY_MFA_FACTOR_TYPES=totp
RECOVERY_AUDIT_PATH=
